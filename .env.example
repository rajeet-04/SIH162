# Local runtime configuration. Never commit real credentials.
FIRMS_KEYS_FILE=data/secrets/firms.mapkey
FIRMS_MAP_KEY=

# Optional NASA Earthdata credentials for protected satellite evidence APIs.
# Prefer a short-lived token over storing a password.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_TOKEN=
NASA_EARTHDATA_BASE_URL=https://urs.earthdata.nasa.gov

# Optional source configuration.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
